{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 4,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml", "*.md", "*.css"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["studio/**/*.ts", "studio/**/*.tsx"],
      "options": {
        "semi": false,
        "tabWidth": 2
      }
    }
  ]
}
